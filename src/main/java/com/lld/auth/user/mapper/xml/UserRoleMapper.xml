<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lld.auth.user.mapper.UserRoleMapper">


    <sql id="Base_Column_List">
        id
        ,role_id,user_id, create_time,
        update_time,creater,updater
    </sql>


<delete id="deleteByUserId">
    delete from user_role where user_id = #{userId}
</delete>

    <select id="getUserRolesByUserIds">
        select
        <include refid="Base_Column_List"/>
        from user_role
        where user_id in
        <foreach collection="userIds" item="item" index="index" open="(" close=")" separator=",">
            #{item}
        </foreach>

    </select>


</mapper>
